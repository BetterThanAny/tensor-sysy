// W5 DCE fixture: run-lir/codegen print every materialised tensor buffer in
// the current IR, so `C` remains observable even though there is no tensor
// return value yet.
const int M = 4;
const int K = 8;
const int N = 4;

void dead_block(tensor<f32>[M, K] A, tensor<f32>[K, N] B) {
    tensor<f32>[M, N] C = @matmul(A, B);
    return;
}

int main() { return 0; }
